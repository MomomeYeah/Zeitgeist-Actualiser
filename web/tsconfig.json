{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vitest/globals", "@testing-library/jest-dom"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    // Relative ("./src/*"), because `paths` entries resolve against
    // `baseUrl` and there is none: TypeScript deprecated `baseUrl` in
    // favour of resolving `paths` against the tsconfig's own directory,
    // which a leading "./" is what asks for. `vite.config.ts` aliases "@"
    // to the same directory for the bundler, which does not read this file.
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src", "vite.config.ts", "eslint.config.js"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
